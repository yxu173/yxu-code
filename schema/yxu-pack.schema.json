            },
            "type": {
              "type": "string",
              "const": "delegate"
            },
            "agent": {
              "type": "string"
            },
            "for_each": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            }
          },
          "required": [
            "id",
