{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/yxu173/yxu-code/main/schema/yxu-pack.schema.json",
  "title": "yxu pack manifest (yxu-pack.yaml)",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "description": "The pack's own version, e.g. 1.2.0",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "yxu": {
      "description": "Oldest yxu this pack works with",
      "type": "string",
      "pattern": "^>=\\s*v?\\d+(\\.\\d+){0,2}(-[\\w.]+)?$"
    },
    "detect": {
      "description": "Files that suggest this pack in `yxu init`, e.g. [pyproject.toml]",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "homepage": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "description": "yxu config this pack adds (agents, settings, workflows, hooks, ui, …)",
      "properties": {
        "orchestrator": {
          "default": {
            "model": "opus",
            "provider": "claude",
            "user_settings": false
          },
          "type": "object",
          "properties": {
            "model": {
              "default": "opus",
              "description": "Claude model that plans, delegates and reviews",
              "type": "string"
            },
            "provider": {
              "default": "claude",
              "description": "Who answers pipeline plan and review steps: claude (default), agent (orchestrator.agent), or an orchestrator added by a plugin. Auto workflows need claude",
              "type": "string"
            },
            "agent": {
              "description": "provider: agent — the agent that plans and reviews (read-only, in its own worktree)",
              "type": "string"
            },
            "effort": {
              "description": "Reasoning effort for the orchestrator",
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            "max_budget_usd": {
              "description": "Stop the orchestrator when a run spends more than this",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_turns": {
              "description": "Orchestrator turn limit per run",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "user_settings": {
              "default": false,
              "description": "Load your global Claude settings, plugins and MCP servers (costly)",
              "type": "boolean"
            }
          }
        },
        "agents": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "cli": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "commandcode",
                          "opencode",
                          "claude",
                          "acp",
                          "generic"
                        ]
                      },
                      {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                      }
                    ],
                    "description": "commandcode, opencode, claude (built in); acp (any Agent Client Protocol agent); generic (any CLI, see command); or a cli added by a plugin"
                  },
                  "command": {
                    "description": "acp: the command that starts the agent, e.g. [gemini, --experimental-acp]. generic: argv with {{task}}, {{model}}, {{cwd}}",
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "output": {
                    "description": "generic: how to read the CLI's stdout (default text)",
                    "type": "string",
                    "enum": [
                      "text",
                      "json",
                      "ndjson"
                    ]
                  },
                  "summary": {
                    "description": "generic: \"last-paragraph\" (default), \"all\", or an expression such as result or last.result",
                    "type": "string"
                  },
                  "success": {
                    "description": "generic: \"exit-code\" (default) or an expression such as \"!is_error\"",
                    "type": "string"
                  },
                  "usage": {
                    "description": "generic json/ndjson: expressions for input/output tokens and cost in USD",
                    "type": "object",
                    "properties": {
                      "input": {
                        "type": "string"
                      },
                      "output": {
                        "type": "string"
                      },
                      "cost": {
                        "type": "string"
                      }
                    }
                  },
                  "models": {
                    "description": "generic: a command that prints one model id per line (for /model completion)",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "env": {
                    "description": "Extra environment; values may reference others as env:NAME",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "model": {
                    "description": "Model id for the CLI, e.g. deepseek/deepseek-v4-flash (see `yxu models`)",
                    "type": "string"
                  },
                  "permission": {
                    "description": "accept-edits (default): edit files, ask for the rest; plan: read only; yolo: anything, no questions",
                    "type": "string",
                    "enum": [
                      "yolo",
                      "accept-edits",
                      "plan"
                    ]
                  },
                  "allow": {
                    "description": "ACP: tools approved without asking, \"kind\" or \"kind:glob\", e.g. [\"execute:npm test*\"]",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "deny": {
                    "description": "ACP: tools always refused",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "sandbox": {
                    "description": "bwrap (Linux): the agent can only write to its worktree and its own state dirs",
                    "type": "string",
                    "enum": [
                      "bwrap",
                      "none"
                    ]
                  },
                  "sandbox_writable": {
                    "description": "Extra writable paths in the sandbox (~ allowed)",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "max_turns": {
                    "description": "Turn limit per task",
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "timeout": {
                    "description": "Kill the task after this long: \"90s\", \"15m\", \"1h\" or seconds",
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "agent": {
                    "description": "Named agent/persona inside the CLI, if it has them",
                    "type": "string"
                  },
                  "description": {
                    "description": "Tells the orchestrator when to use this agent",
                    "type": "string"
                  },
                  "instructions": {
                    "description": "The agent's role: put before every task it gets (e.g. how a reviewer should report)",
                    "type": "string"
                  }
                }
              },
              {
                "type": "null",
                "description": "remove this entry from lower layers"
              }
            ]
          },
          "description": "Local agent CLIs the orchestrator can delegate to"
        },
        "workflows": {
          "description": "How the orchestrator works: auto, or a fixed pipeline of steps",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "default": "auto",
                    "type": "string",
                    "enum": [
                      "auto",
                      "pipeline"
                    ]
                  },
                  "description": {
                    "description": "Shown in /workflow",
                    "type": "string"
                  },
                  "allowed_agents": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "instructions": {
                    "type": "string"
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/__schema0"
                    }
                  },
                  "inputs": {
                    "description": "Values passed with --input name=value or by a command",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "description": {
                          "type": "string"
                        },
                        "default": {
                          "type": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        },
                        "required": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "outputs": {
                    "description": "Results reported at the end (templates)",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "type": "null",
                "description": "remove this entry from lower layers"
              }
            ]
          }
        },
        "settings": {
          "type": "object",
          "properties": {
            "max_diff_chars": {
              "default": 12000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "concurrency": {
              "default": 3,
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "resolver": {
              "type": "string"
            },
            "default_agent": {
              "description": "The agent a workflow step means by `agent: default` (packs use this); default: the first agent",
              "type": "string"
            },
            "verify": {
              "type": "string"
            },
            "verify_timeout": {
              "type": [
                "string",
                "number"
              ]
            },
            "apply": {
              "default": "auto",
              "description": "How results reach your working tree: auto (applied when a run ends, /undo reverts), ask (you choose: apply, diff, later, discard), manual (/apply)",
              "type": "string",
              "enum": [
                "auto",
                "ask",
                "manual"
              ]
            },
            "permissions": {
              "default": "ask",
              "description": "How much runs without asking: ask (ask for approval), auto (a classifier approves or blocks each action, asks when unsure), full (everything runs; agents get yolo)",
              "type": "string",
              "enum": [
                "ask",
                "auto",
                "full"
              ]
            },
            "auto_model": {
              "default": "haiku",
              "description": "The model that approves or blocks actions in permissions: auto",
              "type": "string"
            },
            "checkout_commands": {
              "default": "ask",
              "description": "Commands the orchestrator runs in your own checkout (git commit, push, …): ask before each (default), allow without asking, or off",
              "type": "string",
              "enum": [
                "ask",
                "allow",
                "off"
              ]
            }
          }
        },
        "context": {
          "default": {
            "memory": true,
            "project_instructions": true,
            "include": [],
            "include_max_chars": 20000,
            "repo_map": true,
            "repo_map_chars": 4000
          },
          "type": "object",
          "properties": {
            "memory": {
              "default": true,
              "type": "boolean"
            },
            "project_instructions": {
              "default": true,
              "type": "boolean"
            },
            "include": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "include_max_chars": {
              "default": 20000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "notes": {
              "type": "string"
            },
            "max_diff_chars": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "repo_map": {
              "default": true,
              "description": "Share a map of the repo (files, symbols, tests, conventions) with every agent: the relevant part goes before each task, the overview to the orchestrator",
              "type": "boolean"
            },
            "repo_map_chars": {
              "default": 4000,
              "description": "Characters of the repo map put before each subagent task",
              "type": "integer",
              "minimum": 500,
              "maximum": 50000
            }
          }
        },
        "compact": {
          "type": "object",
          "properties": {
            "auto": {
              "default": true,
              "type": "boolean"
            },
            "window": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "auto"
                },
                {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              ]
            },
            "instructions": {
              "type": "string"
            },
            "warn_at": {
              "default": 0.8,
              "type": "number",
              "minimum": 0.1,
              "maximum": 1
            },
            "background": {
              "default": true,
              "description": "Interface: after a turn, compact a copy of the conversation in the background; you keep working, and the summary takes over when it is ready",
              "type": "boolean"
            },
            "background_at": {
              "default": 0.6,
              "description": "Start background compaction when context use passes this fraction of the window (before Claude Code's own auto-compaction, which pauses the run)",
              "type": "number",
              "minimum": 0.1,
              "maximum": 0.95
            }
          }
        },
        "spawn": {
          "default": {
            "enabled": true,
            "max": 8
          },
          "description": "Subagents the orchestrator creates on its own, from providers and models you choose",
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Let the orchestrator create subagents for a session (spawn_agent)",
              "type": "boolean"
            },
            "models": {
              "description": "The providers and models it may spawn with, e.g. { commandcode: [deepseek/deepseek-v4-pro], claude: [sonnet] }; default: the cli/model pairs your agents use",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "max": {
              "default": 8,
              "description": "Most subagents it may spawn in one session",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "hooks": {
          "description": "Shell commands at lifecycle points; they get the event as JSON on stdin",
          "type": "object",
          "properties": {
            "before_run": {
              "description": "Before a run; a failing command blocks it",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "after_task": {
              "description": "After each agent task, in its worktree; file changes join the task",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "before_apply": {
              "description": "Before apply, in the task's worktree; a failing command blocks the apply",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "on_failure": {
              "description": "After a run that failed",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "on_complete": {
              "description": "After a run that succeeded",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "ui": {
          "default": {
            "theme": "instrument",
            "keys": {},
            "panel": true,
            "panel_sections": [
              "context",
              "agents",
              "tasks",
              "cost"
            ],
            "footer": true,
            "mouse": true
          },
          "description": "The interactive interface: theme, keys, layout",
          "type": "object",
          "properties": {
            "theme": {
              "default": "instrument",
              "description": "instrument, high-contrast, light, mono, or a file in ~/.config/yxu/themes",
              "type": "string"
            },
            "keys": {
              "default": {},
              "description": "Rebind interface keys, e.g. { panel: ctrl+b } (see `yxu keys`)",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "panel": {
              "default": true,
              "description": "Open the side panel at start",
              "type": "boolean"
            },
            "panel_sections": {
              "default": [
                "context",
                "agents",
                "tasks",
                "cost"
              ],
              "description": "Which panel sections to show, in order; plugin sections are \"<plugin>:<title>\" (shown after these unless listed)",
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "context",
                      "agents",
                      "tasks",
                      "cost"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*:.+$"
                  }
                ]
              }
            },
            "footer": {
              "default": true,
              "description": "Show the key hints line",
              "type": "boolean"
            },
            "mouse": {
              "default": true,
              "description": "The mouse wheel scrolls the conversation (select text with shift+drag). false: your terminal handles the mouse",
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "definitions": {
    "__schema0": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "description": {
              "description": "What this step is for (shown while it runs)",
              "type": "string"
            },
            "if": {
              "description": "Run only when true, e.g. \"{{verify.ok}}\" or \"plan.tasks.length > 3\"",
              "type": [
                "string",
                "boolean"
              ]
            },
            "unless": {
              "description": "Skip when true",
              "type": [
                "string",
                "boolean"
              ]
            },
            "continue_on_error": {
              "description": "Record a failure and keep going instead of stopping the workflow",
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "plan"
            },
            "max_tasks": {
              "default": 5,
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "instructions": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
