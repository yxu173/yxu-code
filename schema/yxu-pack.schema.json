              "const": "review"
            },
            "fix_agent": {
              "type": "string"
            },
            "max_rounds": {
              "default": 3,
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "instructions": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "type",
            "fix_agent"
          ]
        },
        {
          "type": "object",
          "properties": {
