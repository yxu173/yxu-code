              "type": "string",
              "const": "shell"
            },
            "command": {
              "type": "string",
              "description": "Shell command (a template; values are shell-quoted). Output feeds later steps as {{<id>.output}}"
            },
            "in": {
              "default": "result",
              "description": "result: the work so far (task worktree, or the repo before any change); repo: your checkout",
              "type": "string",
              "enum": [
                "result",
                "repo"
              ]
            },
            "timeout": {
              "type": [
                "string",
                "number"
              ]
            },
            "env": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
