            },
            "in": {
              "default": "result",
              "description": "result: the work so far (task worktree, or the repo before any change); repo: your checkout",
              "type": "string",
              "enum": [
                "result",
                "repo"
              ]
            },
            "timeout": {
              "type": [
                "string",
                "number"
              ]
            },
            "env": {
              "type": "object",
