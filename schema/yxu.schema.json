            },
            "workflow": {
              "type": "string",
              "description": "Name of a pipeline workflow to run here"
            },
            "inputs": {
              "description": "Inputs for that workflow (templates)",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "goal": {
              "description": "Goal for that workflow (template; default: this workflow's goal)",
