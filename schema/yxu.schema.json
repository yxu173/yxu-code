            },
            "type": {
              "type": "string",
              "const": "parallel"
            },
            "steps": {
              "minItems": 1,
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "#/definitions/__schema0"
                  }
                ]
              },
              "description": "Steps run at the same time; their changes are combined"
            }
          },
          "required": [
            "id",
            "type",
            "steps"
          ]
        },
        {
