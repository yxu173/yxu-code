              "items": {
                "allOf": [
                  {
                    "$ref": "#/definitions/__schema0"
                  }
                ]
              },
              "description": "Steps repeated in order each round"
            },
            "until": {
              "description": "Stop once this is true (checked after each round)",
              "type": [
