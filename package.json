{
  "name": "yxu",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yxu173/yxu-code.git"
  },
  "version": "0.0.1",
  "description": "Local multi-agent orchestrator: Claude Code plans, local coding agents do the work",
  "type": "module",
  "bin": {
    "yxu": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "schema": "bun -e 'import { packSchemaText, schemaText } from \"./src/config-schema.ts\"; await Bun.write(\"schema/yxu.schema.json\", schemaText()); await Bun.write(\"schema/yxu-pack.schema.json\", packSchemaText())'",
    "packs": "bun scripts/gen-packs.ts",
    "build": "bun build --compile src/cli.ts --outfile dist/yxu",
    "release:build": "bun scripts/build-release.ts",
    "smoke": "sh scripts/smoke.sh dist/yxu"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "ajv": "^8",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
